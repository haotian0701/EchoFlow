POSTGRES_DB=echoflow
POSTGRES_USER=echoflow
POSTGRES_PASSWORD=local-dev-password
DATABASE_URL=postgresql+asyncpg://echoflow:local-dev-password@db:5432/echoflow
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CELERY_BROKER_URL=redis://redis:6379/0
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_EVALUATION_MODEL=z-ai/glm-5.3-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=EchoFlow

# Audio configuration is independent of LLM_PROVIDER. Real TTS never falls back to mock.
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
TTS_TIMEOUT_SECONDS=300
TTS_MAX_RESPONSE_BYTES=67108864
TTS_VOICE_CACHE_SECONDS=300
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=echoflow
MINIO_SECRET_KEY=local-dev-password
MINIO_BUCKET=echoflow-audio
MINIO_SECURE=false

